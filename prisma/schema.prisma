generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Tournament {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  name    String @unique
  country String
  year    String
  games   Game[]

  @@map("tournaments")
}

model Team {
  id                 String          @id @default(auto()) @map("_id") @db.ObjectId
  name               String          @unique
  colorPrimary       String
  colorSecondary     String
  allTimeScored      Int             @default(0)
  allTimeConceded    Int             @default(0)
  gameParticipations DataTeamMatch[]

  @@map("teams")
}

model Game {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  date        DateTime
  stadiumName String
  homeScore   Int      @default(0)
  awayScore   Int      @default(0)

  tournamentId String          @db.ObjectId
  tournament   Tournament      @relation(fields: [tournamentId], references: [id])
  teams        DataTeamMatch[]

  @@index([tournamentId])
  @@map("games")
}

model DataTeamMatch {
  id            String @id @default(auto()) @map("_id") @db.ObjectId
  side          String
  matchScored   Int    @default(0)
  matchConceded Int    @default(0)

  gameId String @db.ObjectId
  game   Game   @relation(fields: [gameId], references: [id])

  teamId String @db.ObjectId
  team   Team   @relation(fields: [teamId], references: [id])

  @@unique([gameId, teamId])
  @@index([gameId])
  @@index([teamId])
  @@map("data_team_matches")
}
